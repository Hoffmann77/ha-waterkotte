{
  "selector": {
    "system_type": {
      "options": {
        "ecotouch": "EcoTouch Mode [web-form interface require username & password]",
        "easycon": "EasyCon Mode [older Waterkotte Models with basic-auth login]"
      }
    }
  },
  "config": {
    "step": {
      "user": {
        "description": "If you need help with the configuration have a look here: {repo}.",
        "data": {
          "system_type": "Watterkotte Interface-Typ"
        },
        "data_description": {
          "system_type": "If you need to provide a username & password to log in to the Waterkotte web interface, please select the interface type: EcoTouch Mode, else the EasyCon Mode."
        }
      },
      "user_ecotouch": {
        "data": {
          "host": "Host or IP",
          "username": "Username",
          "password": "Password",
          "polling_interval": "Polling Interval in seconds",
          "tags_per_request": "Number of tags to fetch in a single request (max. 75)"
        }
      },
      "user_easycon": {
        "description": "If you need help with the configuration have a look here: {repo}.",
        "data": {
          "host": "Host or IP",
          "username": "Username (OPTIONAL)",
          "password": "Password (OPTIONAL)",
          "polling_interval": "Polling Interval in seconds",
          "tags_per_request": "Number of tags to fetch in a single request (max. 75)"
        },
        "data_description": {
          "username": "Only if your Watterkotte use BasicAuth to access",
          "password": "Only if your Watterkotte use BasicAuth to access"
        }
      },
      "reconfigure": {
        "description": "Change the Host or IP (e.g. when your Waterkotte got a new IP address) or the login credentials of your Waterkotte.",
        "data": {
          "host": "Host or IP",
          "username": "Username",
          "password": "Password"
        }
      },
      "reauth_confirm": {
        "description": "The login to the Waterkotte at {host} failed - please enter the current username and password.",
        "data": {
          "username": "Username",
          "password": "Password"
        }
      },
      "features": {
        "description": "Activation of additional Sensors und Controls:\n(These can also be activated later manually)",
        "data": {
          "use_vent": "for an 'air source heat pump outdoor unit'",
          "use_heating_curve": "to adjust 'heating curves'",
          "use_disinfection": "to adjust the 'Water disinfection'",
          "use_pool": "for a 'pool' unit' (incl. heating curve)"
        }
      }
    },
    "error": {
      "cannot_connect": "No connection to Waterkotte possible - please check the Host/IP and if you have selected previously the correct Interface-Type.",
      "invalid_auth": "Username or Password is wrong.",
      "too_many_users": "Too many users are logged in to the Waterkotte web interface - please log out from other sessions and try again later.",
      "unknown": "Unexpected error - please check the Home Assistant log."
    },
    "abort": {
      "reauth_successful": "The credentials have been updated.",
      "single_instance_allowed": "Only a single instance is allowed.",
      "already_configured": "This Waterkotte heat pump is already configured.",
      "reconfigure_successful": "The configuration has been updated.",
      "wrong_device": "The heat pump at this Host/IP is not the configured Waterkotte heat pump (different serial number)."
    }
  },
  "options": {
    "step": {
      "user": {
        "description": "If you need help with the configuration have a look here: {repo}.",
        "data": {
          "polling_interval": "Polling Interval in seconds",
          "tags_per_request": "Number of tags to fetch in a single request (max. 75)",
          "add_readonly_copies": "Add read-only copies of the switches, numbers and selects",
          "read_only": "Read-only mode",
          "monthly_statistics": "Add monthly statistics (COP and energy)"
        },
        "data_description": {
          "add_readonly_copies": "Adds a sensor for every setting of the heat pump - e.g. to show it on a dashboard without the risk of changing it.",
          "read_only": "Nothing is written to the heat pump: changing a switch, number, select, date or time (and the service actions, that change settings) fails.",
          "monthly_statistics": "Adds the COP and the energy of the last 12 months (and from then on of every month) to the long-term statistics of Home Assistant - shown with a statistics graph card (period: month)."
        }
      }
    }
  },
  "services": {
    "set_holiday": {
      "name": "Set Holiday",
      "description": "Sets start and end times for holiday mode.",
      "fields": {
        "config_entry_id": {"name": "Heat pump", "description": "The heat pump - only required, when more than one heat pump is configured."},
        "start": {"name": "Start Time & Date", "description": "Set the beginning of the holiday"},
        "end": {"name": "End Time & Date", "description": "Set the end of the holiday"}
      }
    },
    "set_disinfection_start_time": {
      "name": "Set disinfection start time",
      "description": "Set the start time for disinfection",
      "fields": {
        "config_entry_id": {"name": "Heat pump", "description": "The heat pump - only required, when more than one heat pump is configured."},
        "starthhmm": {"name": "Disinfection Start Time", "description": "Set the disinfection start time"}
      }
    },
    "get_energy_balance": {
      "name": "Get Current Year Energy Balance",
      "description": "Get the energy balance by different usage for the current year",
      "fields": {
        "config_entry_id": {"name": "Heat pump", "description": "The heat pump - only required, when more than one heat pump is configured."}
      }
    },
    "get_energy_balance_monthly": {
      "name": "Get rolling 12 Month breakdown",
      "description": "Gets the energy balance breakdown per month in a rolling 12 month window",
      "fields": {
        "config_entry_id": {"name": "Heat pump", "description": "The heat pump - only required, when more than one heat pump is configured."}
      }
    }
  },
  "exceptions": {
    "config_entry_required": {"message": "More than one (or no) Waterkotte heat pump is loaded - please select the heat pump."},
    "config_entry_not_found": {"message": "The heat pump {entry_id} was not found."},
    "config_entry_not_loaded": {"message": "The heat pump {title} is not loaded."},
    "invalid_value": {"message": "The value {value} is not valid for {tag}."},
    "write_failed": {"message": "The value {value} could not be written to {tag}: {error}"},
    "write_not_confirmed": {"message": "The heat pump did not confirm the value {value} for {tag}."},
    "read_failed": {"message": "The values could not be read from the heat pump: {error}"},
    "read_only": {"message": "The integration is in read-only mode - {value} was not written to {tag}."}
  },
